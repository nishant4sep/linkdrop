# Copy to .env.local and fill in values locally.
# Never commit .env.local or real credentials.
#
# NOTE: a previous version of this example file contained what looked like live
# Supabase project keys. If those were ever real, rotate them in the Supabase
# dashboard immediately: they must be treated as compromised.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public origin of the app (used for origin checks and email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# When the site is also reachable on an extra origin (e.g. the apex domain next
# to subdomains), list it so cross-origin checks accept it.
APP_ORIGIN=

# Cash payouts: OFF by default since the pivot to the anonymous directory +
# loyalty model (the reward ledger stays live underneath). Set to 1 to reopen.
REDEMPTIONS_ENABLED=0

# Cloudflare Turnstile (optional, phase 2): set the secret to require a bot
# check on anonymous submissions and reports.
TURNSTILE_SECRET=

# Dedicated salt for IP hashing (recommended once set; falls back to the
# service-role key). Rotating this resets anonymous fingerprint history.
IP_HASH_SALT=

# Owner console subdomain (see README "Owner console"):
#   in most setups just a CNAME/A record dashboard.example.com -> the app host.
